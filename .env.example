DB_URL=jdbc:postgresql://localhost:5432/flowdesk
DB_USERNAME=flowdesk_app
DB_PASSWORD=YOUR_PASSWORD_HERE

# Outbound Email Infrastructure
# Mode 1: Local development with Mailpit (default)
FLOWDESK_MAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
FLOWDESK_MAIL_FROM_ADDRESS=noreply@flowdesk.internal
FLOWDESK_MAIL_FROM_NAME=FlowDesk
FLOWDESK_MAIL_PRODUCTION=false

# Mode 2: Real Gmail SMTP delivery (requires Google Account App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-account@gmail.com
# SMTP_PASSWORD=your-16-char-google-app-password
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_SSL=false
# FLOWDESK_MAIL_FROM_ADDRESS=your-account@gmail.com
# FLOWDESK_MAIL_FROM_NAME=FlowDesk

# Mode 3: Real Transactional SMTP Relay (e.g. SendGrid, Amazon SES, Resend)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_SSL=false
# FLOWDESK_MAIL_FROM_ADDRESS=notifications@yourdomain.com

# Password Recovery & Admin Invitation Setup
FLOWDESK_FRONTEND_ORIGIN=http://localhost:5173
PASSWORD_RESET_TOKEN_VALIDITY_MINUTES=15
INVITATION_TOKEN_VALIDITY_HOURS=48
INVITATION_TOKEN_ENTROPY_BYTES=32

# Google OAuth 2.0 / OpenID Connect (Phase 3)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Google OAuth Rate Limiting (optional overrides)
# RATE_LIMIT_OAUTH_ENABLED=true
# RATE_LIMIT_OAUTH_IP_MAX=30
# RATE_LIMIT_OAUTH_IP_WINDOW=60
