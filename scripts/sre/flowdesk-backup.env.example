# ==============================================================================
# FlowDesk Production Backup & Disaster Recovery Environment Configuration
# ==============================================================================
# Location on Production Host: /etc/flowdesk/backup.env
# Permissions: chmod 600 /etc/flowdesk/backup.env (Owned by root:root)
# ==============================================================================

# Target directory on host filesystem for local backup sets
BACKUP_ROOT=/var/backups/flowdesk

# Number of days to retain local backups (older backups automatically pruned)
RETENTION_DAYS=7

# Minimum free disk space required on backup root volume (in MB)
MIN_FREE_SPACE_MB=1024

# Database connection parameters (within Docker internal network)
USE_DOCKER=true
DB_CONTAINER=flowdesk-prod-postgres
BACKEND_CONTAINER=flowdesk-prod-backend
DB_NAME=flowdesk
DB_USER=flowdesk_app

# Path to persistent attachment volume on host
ATTACHMENTS_DIR=/var/lib/docker/volumes/flowdesk_prod_attachments/_data

# Consistency Strategy:
#   - verified_snapshot : Zero-downtime transactional database dump + attachment archive
#                         with post-backup cryptographic referential consistency audit.
#   - quiescence        : Temporarily pauses backend container during snapshot creation.
CONSISTENCY_MODE=verified_snapshot

# ------------------------------------------------------------------------------
# Off-Host Replication & Encryption (Optional / Recommended)
# ------------------------------------------------------------------------------
# Enable off-host replication after local backup completion (true/false)
OFFSITE_ENABLED=true

# Storage adapter: local_dir (e.g. NFS / mounted disk), oci_cli (Oracle Cloud), or s3
DEST_TYPE=oci_cli

# OCI Object Storage Configuration (Requires OCI CLI configured on host)
OCI_BUCKET=flowdesk-production-backups
OCI_NAMESPACE=your-tenancy-namespace

# S3 Configuration (Alternative adapter)
S3_BUCKET=

# Target path for local_dir adapter (e.g. secondary disk or mounted network storage)
DEST_PATH=/mnt/offsite_backups/flowdesk

# Off-host retention window in days
OFFSITE_RETENTION_DAYS=30

# Client-Side AES-256-CBC Encryption Key (Minimum 16 characters)
# MANDATORY when off-host replication is enabled.
BACKUP_ENCRYPTION_KEY=YourStrongDisasterRecoveryPassphrase2026!

# Prometheus Node Exporter Textfile Collector Directory for Metrics (Optional)
METRICS_DIR=/var/lib/node_exporter/textfile_collector

