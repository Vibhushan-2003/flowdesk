# Database Configuration (Dedicated E2E Database)
E2E_DB_NAME=flowdesk_e2e
E2E_DB_USER=flowdesk_app
E2E_DB_PASSWORD=flowdesk_e2e_password
E2E_DB_PORT=5433

# Ports (Disjoint from development and default Compose instances)
E2E_FRONTEND_PORT=3001
E2E_BACKEND_PORT=8089
E2E_MAILPIT_WEB_PORT=8027

# Security
E2E_JWT_SECRET=e2e-super-secret-jwt-signing-key-flowdesk-day57-isolated-256bit

