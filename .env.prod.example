# ==============================================================================
# FlowDesk Production Environment Template (.env.prod.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env.prod on your production host: cp .env.prod.example .env.prod
# 2. Restrict file permissions immediately: chmod 600 .env.prod
# 3. Fill in all placeholder values before launching the stack.
# 4. NEVER commit .env.prod or real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Relational Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Database name and service user
DB_NAME=flowdesk
DB_USER=flowdesk_app
DB_USERNAME=flowdesk_app
# Generate a strong password (e.g. using: openssl rand -base64 32)
DB_PASSWORD=REPLACE_WITH_STRONG_GENERATED_DB_PASSWORD_MIN_32_CHARS

# Internal Docker JDBC connection URL
DB_URL=jdbc:postgresql://postgres:5432/flowdesk

# HikariCP connection pool limits for a 2 OCPU / 12 GB RAM instance
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 2. Security & JWT Cryptographic Keys
# ------------------------------------------------------------------------------
# 256-bit (or 512-bit) base64-encoded HMAC secret (generate via: openssl rand -base64 32)
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_BASE64_256BIT_SECRET

# JWT Token Lifecycles
JWT_ISSUER=flowdesk
ACCESS_TOKEN_TTL=PT15M
ACCESS_TOKEN_DURATION_SECONDS=900
REFRESH_TOKEN_IDLE_SECONDS=604800
REFRESH_TOKEN_MAX_LIFETIME_SECONDS=2592000
REFRESH_TOKEN_GRACE_PERIOD_SECONDS=30

# ------------------------------------------------------------------------------
# 3. Ingress, TLS Mode & Domain Configuration
# ------------------------------------------------------------------------------
# Choose EXACTLY ONE mode below:
#
# --- MODE A: Local Isolated Testing & Verification ---
# Uses Caddy's internal self-signed CA. No public DNS or ACME registration needed.
CADDY_DOMAIN=localhost
CADDY_TLS=internal
FRONTEND_ORIGIN=https://localhost
FLOWDESK_FRONTEND_ORIGIN=https://localhost
#
# --- MODE B: Public Production Deployment (Uncomment for live public deployment) ---
# Automated publicly trusted certificates via Let's Encrypt / ZeroSSL.
# Requires valid public DNS record pointing to your VM's public IP address.
# CADDY_DOMAIN=tickets.example.com
# CADDY_TLS=admin@example.com
# FRONTEND_ORIGIN=https://tickets.example.com
# FLOWDESK_FRONTEND_ORIGIN=https://tickets.example.com

# Ingress Ports (published on host only by Caddy)
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ------------------------------------------------------------------------------
# 4. Reverse Proxy & Client IP Trust Configuration
# ------------------------------------------------------------------------------
# In production Docker Compose (docker-compose.prod.yml), Caddy is pinned to
# static IP 172.28.0.2 on proxy_net. Tomcat and Spring filters trust ONLY
# 172.28.0.2 to unwrap client IPs for login rate limiting.
SERVER_FORWARD_HEADERS_STRATEGY=native
RATE_LIMIT_LOGIN_TRUST_PROXY=true
RATE_LIMIT_TRUSTED_PROXIES=172.28.0.2
TOMCAT_INTERNAL_PROXIES=172\.28\.0\.2

# ------------------------------------------------------------------------------
# 5. Outbound Transactional Email (Port 587 STARTTLS)
# ------------------------------------------------------------------------------
# Recommended free providers: Brevo (300/day free), Resend (100/day free), or SendGrid
FLOWDESK_MAIL_ENABLED=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_YOUR_SMTP_LOGIN
SMTP_PASSWORD=REPLACE_WITH_YOUR_SMTP_KEY_OR_PASSWORD
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
FLOWDESK_MAIL_FROM_ADDRESS=noreply@flowdesk.example.com
FLOWDESK_MAIL_FROM_NAME=FlowDesk Support

# ------------------------------------------------------------------------------
# 6. Private Attachment Storage & ClamAV Antivirus
# ------------------------------------------------------------------------------
# Path mapped to persistent Docker volume (flowdesk_prod_attachments)
ATTACHMENT_STORAGE_DIR=/app/data/attachments
ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
ATTACHMENT_MAX_PER_TICKET=10
FLOWDESK_MULTIPART_MAX_FILE_SIZE=10MB
FLOWDESK_MULTIPART_MAX_REQUEST_SIZE=15MB

# ClamAV daemon container hostname and port (internal Docker network)
MALWARE_SCANNER_ENABLED=true
MALWARE_SCANNER_TYPE=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_CONNECTION_TIMEOUT_MS=3000
CLAMAV_READ_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 7. Optional AI & External Integrations
# ------------------------------------------------------------------------------
# Optional Google Gemini AI (leave empty to disable AI features cleanly)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional Google OAuth 2.0 (set to true and supply credentials to enable)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://flowdesk.example.com/auth/google/callback

# ------------------------------------------------------------------------------
# 8. Operational & Administrative Controls
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
FLOWDESK_PRODUCTION=true
FLOWDESK_BOOTSTRAP_ADMIN_ENABLED=false
FLOWDESK_BOOTSTRAP_ADMIN_EMAIL=
FLOWDESK_BOOTSTRAP_ADMIN_PASSWORD=
SPRING_JPA_SHOW_SQL=false
