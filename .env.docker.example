# ==============================================================================
# FlowDesk Docker Deployment Environment Configuration Template
# Copy this file to .env.docker before starting Docker Compose:
#   cp .env.docker.example .env.docker
#
# IMPORTANT:
# - Never overwrite your development .env file with this file.
# - Never commit your populated .env.docker file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# These credentials configure the isolated containerized database (flowdesk-postgres).
# They do NOT affect or connect to your local Windows PostgreSQL service.
# ------------------------------------------------------------------------------
DB_NAME=flowdesk
DB_USER=flowdesk_app
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD

# ------------------------------------------------------------------------------
# JWT Authentication Security Key
# A high-entropy 256-bit cryptographic secret for signing HMAC-SHA256 tokens.
# Generate on Linux/macOS/Git Bash:
#   openssl rand -base64 32
# Generate on Windows PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
# ------------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_BASE64_256BIT_SECRET

# ------------------------------------------------------------------------------
# Host Port Allocations (Configured to avoid conflicts with local dev servers)
# - Frontend: 3000 (Vite dev server runs on 5173)
# - Mailpit Web UI: 8026 (Port 8026 prevents collision if 8025 is busy)
# Note: PostgreSQL (5432) and Backend (8080) remain internal to Docker network.
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
MAILPIT_WEB_PORT=8026

# ------------------------------------------------------------------------------
# Frontend & Application Origins
# Used by Nginx, CORS validation, and invitation/password-reset email links.
# ------------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_API_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Outbound Email Subsystem (Mailpit container integration)
# ------------------------------------------------------------------------------
FLOWDESK_MAIL_FROM_ADDRESS=noreply@flowdesk.internal
FLOWDESK_MAIL_FROM_NAME=FlowDesk

# ------------------------------------------------------------------------------
# Optional AI Copilot / Triage (Google Gemini API)
# Leave blank to run FlowDesk with rule-based heuristics only.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Diagnostic SQL Logging
# Set to 'true' only if investigating Hibernate queries in container logs.
# ------------------------------------------------------------------------------
SPRING_JPA_SHOW_SQL=false
